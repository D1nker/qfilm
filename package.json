{
  "name": "qfilm",
  "private": true,
  "version": "0.1.0",
  "description": "Film look and frame studio",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "npm run dev -w @qfilm/ui",
    "build": "npm run build -w @qfilm/ui",
    "preview": "npm run preview -w @qfilm/ui",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "typecheck": "npm run typecheck -w @qfilm/ui",
    "lint": "npm run lint -w @qfilm/ui",
    "lint:fix": "npm run lint:fix -w @qfilm/ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all --check",
    "rust:bindings": "UPDATE_BINDINGS=1 cargo test -p app bindings",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:rust": "npm run rust:fmt:check && npm run rust:lint",
    "check:all": "npm run check && npm run check:rust",
    "test": "npm run test -w @qfilm/ui",
    "test:watch": "npm run test:watch -w @qfilm/ui",
    "test:rust": "cargo test --workspace",
    "e2e": "npm run e2e -w @qfilm/ui",
    "test:all": "npm run test && npm run test:rust && npm run e2e"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "prettier": "^3.9.10"
  }
}
