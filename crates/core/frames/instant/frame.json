{
  "id": "instant",
  "name": {
    "fr": "Instantané",
    "en": "Instant"
  },
  "description": {
    "fr": "Marge basse haute, comme un tirage instantané.",
    "en": "A deeper bottom margin, like an instant print."
  },
  "captionDefaults": {
    "color": "#23262b",
    "font": "handwritten",
    "size": 5
  },
  "params": [
    {
      "id": "width",
      "label": {
        "fr": "Épaisseur",
        "en": "Thickness"
      },
      "type": "number",
      "min": 1,
      "max": 30,
      "step": 0.5,
      "unit": "%",
      "default": 6
    },
    {
      "id": "color",
      "label": {
        "fr": "Couleur",
        "en": "Color"
      },
      "type": "color",
      "default": "#f6f4ee"
    }
  ]
}
