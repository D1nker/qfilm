{
  "id": "film120",
  "name": {
    "fr": "Moyen format",
    "en": "Medium format"
  },
  "description": {
    "fr": "Pellicule 120 : pas de perforations, marquages sur le bord.",
    "en": "120 film: no sprocket holes, markings along the edge."
  },
  "rotatePortrait": true,
  "params": [
    {
      "id": "stock",
      "label": {
        "fr": "Pellicule",
        "en": "Film stock"
      },
      "type": "choice",
      "display": "list",
      "section": {
        "fr": "Pellicule",
        "en": "Film stock"
      },
      "default": "amber",
      "options": [
        {
          "id": "amber",
          "label": {
            "fr": "Ambre",
            "en": "Amber"
          },
          "sets": {
            "color": "#120f0c",
            "ink": "#f0a63c",
            "text": "PORTRAIT 400"
          }
        },
        {
          "id": "white",
          "label": {
            "fr": "Blanc",
            "en": "White"
          },
          "sets": {
            "color": "#0d0d0d",
            "ink": "#f2f2f2",
            "text": "CLASSIQUE 400"
          }
        },
        {
          "id": "minimal",
          "label": {
            "fr": "Blanc sobre",
            "en": "Plain white"
          },
          "sets": {
            "color": "#0d0d0d",
            "ink": "#f2f2f2",
            "text": "REPORTAGE 400"
          }
        },
        {
          "id": "green",
          "label": {
            "fr": "Vert",
            "en": "Green"
          },
          "sets": {
            "color": "#0d1210",
            "ink": "#6fce8a",
            "text": "VERT VIF 400"
          }
        },
        {
          "id": "red",
          "label": {
            "fr": "Rouge",
            "en": "Red"
          },
          "sets": {
            "color": "#120d0d",
            "ink": "#ef6f5c",
            "text": "NUIT 800T"
          }
        },
        {
          "id": "cine",
          "label": {
            "fr": "Ciné",
            "en": "Cine"
          },
          "sets": {
            "color": "#100e0c",
            "ink": "#e8dcc0",
            "text": "CINÉ 500T"
          }
        },
        {
          "id": "plain",
          "label": {
            "fr": "Sans marquages",
            "en": "No markings"
          },
          "sets": {
            "color": "#0a0a0a",
            "text": ""
          }
        }
      ],
      "persist": true
    },
    {
      "id": "width",
      "label": {
        "fr": "Épaisseur",
        "en": "Thickness"
      },
      "type": "number",
      "min": 1,
      "max": 30,
      "step": 0.5,
      "unit": "%",
      "default": 10
    },
    {
      "id": "color",
      "label": {
        "fr": "Support",
        "en": "Base"
      },
      "type": "color",
      "default": "#120f0c"
    },
    {
      "id": "sprockets",
      "label": {
        "fr": "Perforations",
        "en": "Sprocket holes"
      },
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "id": "ink",
      "label": {
        "fr": "Marquages",
        "en": "Markings"
      },
      "type": "color",
      "default": "#f0a63c",
      "visibleIf": {
        "param": "stock",
        "notEquals": "plain"
      }
    },
    {
      "id": "text",
      "label": {
        "fr": "Texte pellicule",
        "en": "Film text"
      },
      "type": "text",
      "default": "PORTRAIT 400",
      "maxLength": 60,
      "visibleIf": {
        "param": "stock",
        "notEquals": "plain"
      },
      "fromLook": true
    },
    {
      "id": "frameNumber",
      "label": {
        "fr": "Numéro de vue",
        "en": "Frame number"
      },
      "type": "text",
      "default": "24A",
      "maxLength": 12,
      "visibleIf": {
        "param": "stock",
        "notEquals": "plain"
      },
      "persist": true
    }
  ]
}
