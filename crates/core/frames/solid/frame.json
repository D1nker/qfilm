        "fr": "Épaisseur",
        "en": "Thickness"
      },
      "type": "number",
      "min": 1,
      "max": 30,
      "step": 0.5,
      "unit": "%",
      "default": 4
    },
    {
      "id": "color",
      "label": {
        "fr": "Couleur",
        "en": "Color"
      },
      "type": "color",
      "default": "#ffffff"
    }
  ]
}
