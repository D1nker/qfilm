{
  "id": "solid",
  "name": {
    "fr": "Marge unie",
    "en": "Solid margin"
  },
  "description": {
    "fr": "Une marge régulière autour de la photo.",
    "en": "An even margin around the photo."
  },
  "captionDefaults": {
    "color": "#1a1a1a"
  },
